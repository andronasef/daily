<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl" android:padding="12dp" android:background="@drawable/intercede_widget_bg">
    <TextView android:id="@+id/intercede_title" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical|start" android:text="تشفع اليوم" android:textStyle="bold" android:fontFamily="@font/cairo" android:textColor="#FFFFFF" android:textSize="16sp" />
    <TextView android:id="@+id/intercede_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center" android:text="افتح التطبيق لتحميل الصلوات" android:fontFamily="@font/cairo" android:textColor="#FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/intercede_row_1" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical|start" android:fontFamily="@font/cairo" android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:background="?android:attr/selectableItemBackground" />
    <TextView android:id="@+id/intercede_row_2" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical|start" android:fontFamily="@font/cairo" android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:background="?android:attr/selectableItemBackground" />
    <TextView android:id="@+id/intercede_row_3" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical|start" android:fontFamily="@font/cairo" android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:background="?android:attr/selectableItemBackground" />
    <TextView android:id="@+id/intercede_row_4" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical|start" android:fontFamily="@font/cairo" android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:background="?android:attr/selectableItemBackground" />
    <TextView android:id="@+id/intercede_row_5" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical|start" android:fontFamily="@font/cairo" android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:background="?android:attr/selectableItemBackground" />
</LinearLayout>
