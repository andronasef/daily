<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/verse_widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/verse_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:fontFamily="@font/cairo" android:maxLines="2"
            android:textColor="#CCFFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/verse_open" android:layout_width="48dp"
            android:layout_height="48dp" android:gravity="center"
            android:text="↗" android:textSize="22sp" android:textColor="#FFFFFF"
            android:contentDescription="فتح المحتوى كامل"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Fills the remaining space; text shrinks/grows to fit the widget size. -->
    <TextView
        android:id="@+id/verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/cairo"
        android:gravity="center_vertical|start"
        android:textColor="#FFFFFF" />
</LinearLayout>
